[Unit]
Description=aie-brief: nieuwe AI Engineer-talks ophalen en samenvatten
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory=@DEST@
EnvironmentFile=@DEST@/.env
TimeoutStartSec=2h
ExecStart=@DEST@/venv/bin/python -m aiebrief.cli nacht
